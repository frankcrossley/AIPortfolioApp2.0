rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Every document in this app lives under /users/{uid}/... - only the
    // signed-in account that owns {uid} may ever read or write its data.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function hasName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    function isValidEstateItem(data) {
      return data.id is string && data.id.size() <= 128 &&
             hasName(data) &&
             data.type in ['Platform', 'Application', 'Agent', 'Initiative', 'Embedded AI', 'Experiment', 'Other'] &&
             data.lifecycleStage in ['Ideation', 'Evaluation', 'Development', 'Pilot', 'Production', 'In progress', 'Retired'] &&
             data.status in ['Active', 'In progress', 'Planning', 'Under Review', 'On hold', 'Retired'] &&
             data.department is string && data.department.size() <= 100;
    }

    function isValidRelationship(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.sourceId is string && data.sourceId.size() <= 128 &&
             data.targetId is string && data.targetId.size() <= 128 &&
             data.type in ['Built on', 'Uses', 'Part of', 'Depends on', 'Delivered through', 'Owned by', 'Data flow'];
    }

    match /users/{uid} {
      // Estate items: agents, applications, platforms, embedded AI, experiments
      match /estateItems/{itemId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(itemId) && isValidEstateItem(incoming());
        allow delete: if isOwner(uid) && isValidId(itemId);
      }

      // Initiatives: business/delivery efforts, modeled separately from estate items
      match /initiatives/{itemId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(itemId) && hasName(incoming());
        allow delete: if isOwner(uid) && isValidId(itemId);
      }

      // Relationships between estate items / initiatives
      match /relationships/{relId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(relId) && isValidRelationship(incoming());
        allow delete: if isOwner(uid) && isValidId(relId);
      }

      // Configuration Portal master data
      match /businessUnits/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(docId) && hasName(incoming());
        allow delete: if isOwner(uid) && isValidId(docId);
      }

      match /resourceRates/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(docId);
        allow delete: if isOwner(uid) && isValidId(docId);
      }

      match /benefitCategories/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(docId) && hasName(incoming());
        allow delete: if isOwner(uid) && isValidId(docId);
      }

      match /strategicObjectives/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(docId) && hasName(incoming());
        allow delete: if isOwner(uid) && isValidId(docId);
      }

      match /people/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(docId) && hasName(incoming());
        allow delete: if isOwner(uid) && isValidId(docId);
      }

      match /teams/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(docId) && hasName(incoming());
        allow delete: if isOwner(uid) && isValidId(docId);
      }
    }
  }
}
